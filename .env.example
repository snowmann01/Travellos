# -----------------------------------------------------------------------------
# Travello — copy to `Server/.env` and/or `Travel/.env` as noted per variable.
# -----------------------------------------------------------------------------

# --- Backend (`Server/.env`) ------------------------------------------------
MONGO_URI=mongodb://localhost:27017/travello
JWT_SECRET=your-jwt-secret
PORT=5000

# Google Gemini (preferred for /api/itinerary/generate)
GEMINI_API_KEY=
# Optional override if your project uses a different model id
# GEMINI_MODEL=gemini-1.5-flash

# Alternative LLM: OpenRouter (JSON itinerary draft)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-2.0-flash-001:free

# OpenTripMap: optional API key for higher rate limits (basic calls work without)
# OPENTRIPMAP_API_KEY=

# --- Frontend (`Travel/.env`) -----------------------------------------------
# Mapbox public token (Mapbox GL JS)
VITE_MAPBOX_ACCESS_TOKEN=
# This project also supports the existing variable name:
# VITE_MAPBOX_TOKEN=

# API base for production (omit in local dev if using Vite proxy + main.jsx default)
# VITE_API_URL=https://your-api.example.com/api

# Vite dev proxy target (optional; see Travel/vite.config.js)
# VITE_PROXY_TARGET=http://localhost:5000
